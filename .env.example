# Day 6 pgvector (local Docker, project day6_student_starter)
DATABASE_URL=postgresql://day6:<password>@127.0.0.1:55433/day6_lab
DAY6_STRATEGY=B
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma
# LLM for the agent (API). Put the real key only in .env, never in .env.example
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# Spending guard for API calls (USD). Prices per 1M tokens — verify on the provider's pricing page
MAX_COST_USD=1.0
LLM_PRICE_IN_PER_M=0.20
LLM_PRICE_OUT_PER_M=1.20
LLM_REASONING_EFFORT=low
